option_settings:
  aws:elasticbeanstalk:container:python:
    WSGIPath: wsgi:application
  aws:elasticbeanstalk:application:environment:
    PYTHONPATH: "/var/app/current:$PYTHONPATH"

files:
  "/etc/nginx/conf.d/session_based_proxy.conf":
    mode: "000644"
    owner: root
    group: root
    content: |
      # Map to extract session_id from request body
      map $request_body $session_id_from_body {
          default "";
          "~*\"session_id\":\"([^\"]+)\"" $1;
      }
      
      # Extract session_id from URL path (for session deletion)
      map $uri $session_id_from_path {
          default "";
          "~*/session/[^/]+/(.+)$" $1;
      }
      
      # Extract from query parameters
      map $args $session_id_from_query {
          default "";
          "~*session_id=([^&]*)" $1;
      }
      
      # Use the first available session_id
      map $session_id_from_body$session_id_from_path$session_id_from_query $final_session_id {
          default "no_session";
          "~(.+)" $1;
      }
      
      # Extract agent_id as fallback for routing
      map $request_body $agent_id_from_body {
          default "";
          "~*\"agent_id\":\"([^\"]+)\"" $1;
      }
      
      map $args $agent_id_from_query {
          default "";
          "~*agent_id=([^&]*)" $1;
      }
      
      # Final routing key: prefer session_id, fallback to agent_id
      map $final_session_id $routing_key {
          "no_session" $agent_id_from_body$agent_id_from_query;
          default $final_session_id;
      }
      
      # Upstream with consistent hashing based on session/agent
      upstream gunicorn_workers {
          hash $routing_key consistent;
          server 127.0.0.1:8000;
      }
      
      server {
          listen 80;
          server_name _;
          
          # Increase body size for file uploads
          client_max_body_size 100M;
          
          # Timeouts
          proxy_connect_timeout       60s;
          proxy_send_timeout          60s;
          proxy_read_timeout          60s;
          
          location / {
              # Set routing key for hashing
              set $session_id $routing_key;
              
              # If no routing key found, use round-robin
              if ($session_id = "") {
                  set $session_id "round_robin_$request_id";
              }
              
              proxy_pass http://gunicorn_workers;
              
              # Standard proxy headers
              proxy_set_header Host $host;
              proxy_set_header X-Real-IP $remote_addr;
              proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
              proxy_set_header X-Forwarded-Proto $scheme;
              
              # Add routing info to headers for debugging
              proxy_set_header X-Session-ID $final_session_id;
              proxy_set_header X-Routing-Key $routing_key;
              proxy_set_header X-Agent-ID $agent_id_from_body$agent_id_from_query;
              
              # WebSocket support
              proxy_http_version 1.1;
              proxy_set_header Upgrade $http_upgrade;
              proxy_set_header Connection "upgrade";
          }
          
          # Health check endpoint
          location /health {
              proxy_pass http://127.0.0.1:8000/health;
              access_log off;
          }
      }

  "/opt/elasticbeanstalk/hooks/appdeploy/post/99_restart_nginx.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      systemctl restart nginx || service nginx restart

  "/opt/elasticbeanstalk/hooks/appdeploy/post/98_set_worker_env.sh":
    mode: "000755"
    owner: root
    group: root
    content: |
      #!/bin/bash
      # Set worker environment variable for identification
      export WORKER_ID="eb-worker-$(hostname)"
      echo "WORKER_ID=eb-worker-$(hostname)" >> /opt/python/current/env

commands:
  01_install_nginx_modules:
    command: "nginx -V 2>&1 | grep -o with-http_realip_module || echo 'realip module check'"
    ignoreErrors: true
